            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "issue_id",
          "incarnation",
          "session_id",
          "generation"
        ]
      },
      "observed_memory_revision": {
        "type": "string",
        "maxLength": 4100,
        "description": "Opaque token from memory_context with with_revision. The advisory covers that project, including on unfiltered list/search."
      }
    },
    "required": [
      "id",
      "changes"
    ],
    "additionalProperties": false
  },
  "wait": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "since",
      "timeout"
    ],
    "properties": {
      "since": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Return events after this seq. Start with 0, then pass next_since."
      },
      "incarnation": {
        "type": "string",
        "pattern": "^[a-f0-9]{32}$",
        "description": "Required when since is greater than 0: the incarnation of the earlier page."
      },
      "project": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "issue_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{0,15}-[1-9][0-9]*(\\.[1-9][0-9]*){0,7}$"
        },
        "minItems": 1,
        "maxItems": 50,
        "uniqueItems": true
      },
      "kinds": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "created",
            "updated",
            "status_changed",
            "commented",
            "claim_acquired",
            "claim_released",
            "dependency_added",
            "dependency_removed",
            "became_ready",
            "comment_edited",
            "starred",
            "unstarred"
          ]
        },
        "minItems": 1,
        "maxItems": 12,
        "uniqueItems": true
      },
      "timeout": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Seconds to wait. Required. There is no default."
      }
    }
  }
}
